+++ b/baked_in_test.go
@@ -4201,6 +4201,18 @@ func TestIsCron(t *testing.T) {
 		{"0 0 * * 0",        true},   // every Sunday
 		{"0 0 * * 1-5",      true},   // weekdays
 		{"@monthly",         true},   // shorthand
+		// star-step syntax (*/N) — these were incorrectly rejected before this fix
+		{"*/5 * * * *",      true},   // every 5 minutes
+		{"0 */2 * * *",      true},   // every 2 hours
+		{"0 */1 * * *",      true},   // every hour via */1
+		{"0 0 */7 * *",      true},   // every 7 days
+		{"0 0 1 */3 *",      true},   // quarterly
+		{"0 0 1 */6 *",      true},   // every 6 months
+		{"*/1 * * * *",      true},   // every minute via */1
+		{"*/59 * * * *",     true},   // every 59 minutes
+		{"0 */12 * * *",     true},   // twice daily
+		{"* * * */2 *",      true},   // every other month
 	}
